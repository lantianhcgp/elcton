<div class="page" @swipe="onSwipe">
  <div class="loading" if="{{ !ready }}"><text class="loading-text">{{ layoutError }}</text></div>
  <div class="frame" if="{{ ready && !showDeleteConfirm }}" style="width: {{ paneW }}px; height: {{ h }}px; padding-top: {{ top }}px; padding-bottom: {{ bottom }}px;">
    <div class="header-bar" style="width: {{ paneW }}px; height: {{ headerH }}px;"><text class="page-title" style="font-size: {{ titleSize }}px;">&#x8bfe;&#x7a0b;&#x8be6;&#x60c5;</text></div>
    <list class="detail-list" ref="detailList" style="width: {{ paneW }}px; height: {{ bodyH }}px;">
      <list-item class="name-item" style="width: {{ paneW }}px; height: {{ detailRowH }}px;"><text class="detail-name" style="width: {{ paneW }}px; height: {{ detailRowH }}px; font-size: {{ titleSize }}px;">{{ courseName }}</text></list-item>
      <list-item class="detail-item" for="{{ (idx, row) in detailRows }}" style="width: {{ paneW }}px; height: {{ detailRowH }}px;">
        <div class="detail-row" style="width: {{ paneW }}px; height: {{ detailRowH }}px;">
          <text class="detail-label" style="width: {{ labelW }}px; font-size: {{ smallSize }}px;">{{ row.label }}</text>
          <div class="detail-value-box" style="width: {{ valueW }}px; height: {{ detailRowH }}px;"><text class="detail-value" style="width: {{ valueW }}px; font-size: {{ textSize }}px;">{{ row.value }}</text></div>
        </div>
      </list-item>
      <list-item class="error-item" if="{{ saveError !== '' }}" style="width: {{ paneW }}px; height: {{ detailRowH }}px;"><text class="error-text" style="width: {{ paneW }}px; font-size: {{ smallSize }}px;">{{ saveError }}</text></list-item>
      <list-item class="action-item" style="width: {{ paneW }}px; height: {{ detailRowH }}px;">
        <div class="del-btn" @click="onDelete" style="width: {{ paneW }}px; height: {{ buttonH }}px;"><text class="button-text" style="font-size: {{ textSize }}px;">&#x5220;&#x9664;&#x8bfe;&#x7a0b;</text></div>
      </list-item>
    </list>
    <div class="bottom-bar" style="width: {{ paneW }}px; height: {{ footerH }}px;"><div class="back-btn" @click="onBack" style="width: {{ paneW }}px; height: {{ buttonH }}px;"><text class="button-text" style="font-size: {{ textSize }}px;">&#x8fd4;&#x56de;</text></div></div>
  </div>
  <div class="overlay" if="{{ ready && showDeleteConfirm }}" style="width: {{ w }}px; height: {{ h }}px;">
    <div class="dialog" style="width: {{ dialogW }}px; height: {{ dialogH }}px;">
      <text class="dialog-title" style="width: {{ valueW }}px; height: {{ dialogTitleH }}px; font-size: {{ titleSize }}px;">&#x786e;&#x8ba4;&#x5220;&#x9664;&#xff1f;</text>
      <text class="dialog-hint" style="width: {{ valueW }}px; height: {{ dialogTitleH }}px; font-size: {{ smallSize }}px;">&#x624b;&#x673a;&#x540c;&#x6b65;&#x65f6;&#x4f1a;&#x63d0;&#x793a;&#x51b2;&#x7a81;</text>
      <div class="dialog-row" style="width: {{ paneW }}px; height: {{ footerH }}px;">
        <div class="dialog-cancel" @click="onCancelDelete" style="width: {{ dialogButtonW }}px; height: {{ buttonH }}px; margin-right: {{ gap }}px;"><text class="button-text" style="font-size: {{ textSize }}px;">&#x53d6;&#x6d88;</text></div>
        <div class="dialog-confirm" @click="onConfirmDelete" style="width: {{ dialogButtonW }}px; height: {{ buttonH }}px;"><text class="button-text" style="font-size: {{ textSize }}px;">&#x5220;&#x9664;</text></div>
      </div>
    </div>
  </div>
</div>
