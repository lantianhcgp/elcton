<div class="container">
    <div class="header-bar">
        <text class="title">&#x540C;&#x6B65;&#x6D4B;&#x8BD5;</text>
        <text class="subtitle">LAN &#x53EF;&#x8FBE;&#x6027;</text>
    </div>
    <list class="probe-list">
        <list-item class="probe-item" for="{{ (idx, item) in probes }}">
            <div class="probe-bg">
                <text class="probe-name">{{ item.name }}</text>
                <text class="probe-status" style="color: {{ item.color }};">{{ item.status }}</text>
            </div>
        </list-item>
    </list>
    <div class="detail-box">
        <text class="detail-text">{{ detail }}</text>
    </div>
    <div class="bottom-bar">
        <div class="nav-btn-alt" @click="onBack">
            <text class="nav-btn-text">&#x8FD4;&#x56DE;</text>
        </div>
        <div class="nav-btn" @click="onRun">
            <text class="nav-btn-text">&#x91CD;&#x6D4B;</text>
        </div>
    </div>
</div>
