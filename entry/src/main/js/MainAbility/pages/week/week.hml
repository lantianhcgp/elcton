<div class="page">
  <div class="loading" if="{{ !ready }}"><text class="loading-text">{{ layoutError }}</text></div>
  <div class="frame" if="{{ ready }}" style="width: {{ paneW }}px; height: {{ h }}px; padding-top: {{ top }}px; padding-bottom: {{ bottom }}px;">
    <div class="header-bar" style="width: {{ paneW }}px; height: {{ headerH }}px;">
      <text class="page-title" style="font-size: {{ titleSize }}px;">&#x5468;&#x8bfe;&#x8868;</text>
      <div class="week-label-bg" @click="onWeekModeClick" style="width: {{ tabW }}px; height: {{ tabH }}px;"><text class="week-label" style="font-size: {{ textSize }}px;">{{ weekDisplay }}</text></div>
    </div>
    <div class="day-tabs" style="width: {{ paneW }}px; height: {{ tabsH }}px;">
      <div class="day-slot" for="{{ (idx, day) in days }}" style="width: {{ tabW }}px; height: {{ tabH }}px; margin-right: {{ tabGap }}px;">
        <div class="day-tab" if="{{ selectedDay === day.id }}" @click="onDaySelect(day.id)" style="width: {{ tabW }}px; height: {{ tabH }}px;"><text class="day-tab-text" style="font-size: {{ textSize }}px;">{{ day.label }}</text></div>
        <div class="day-tab-inactive" if="{{ selectedDay !== day.id }}" @click="onDaySelect(day.id)" style="width: {{ tabW }}px; height: {{ tabH }}px;"><text class="day-tab-text-off" style="font-size: {{ textSize }}px;">{{ day.label }}</text></div>
      </div>
    </div>
    <list class="course-list" ref="courseList" style="width: {{ paneW }}px; height: {{ listH }}px;">
      <list-item class="item" for="{{ (idx, item) in dayCourses }}" @click="onCourseClick(item.id)" style="width: {{ paneW }}px; height: {{ rowH }}px;">
        <div class="item-bg" style="width: {{ paneW }}px; height: {{ cardH }}px;">
          <text class="item-name" style="width: {{ cardInnerW }}px; height: {{ cardNameH }}px; font-size: {{ textSize }}px;">{{ item.name }}</text>
          <text class="item-teacher" style="width: {{ cardInnerW }}px; height: {{ cardMetaH }}px; font-size: {{ smallSize }}px;">{{ item.teacher }} {{ item.location }}</text>
          <text class="item-time" style="width: {{ cardInnerW }}px; height: {{ cardTimeH }}px; font-size: {{ smallSize }}px; color: {{ item.statusColor }};">{{ item.timeRange }}</text>
        </div>
      </list-item>
      <list-item class="item" if="{{ isEmpty }}" style="width: {{ paneW }}px; height: {{ rowH }}px;"><text class="empty-text" style="width: {{ paneW }}px; font-size: {{ textSize }}px;">&#x8fd9;&#x5929;&#x6ca1;&#x6709;&#x8bfe;&#x7a0b;</text></list-item>
    </list>
    <div class="bottom-bar" style="width: {{ paneW }}px; height: {{ footerH }}px;">
      <div class="back-btn" @click="onBack" style="width: {{ buttonW }}px; height: {{ buttonH }}px; margin-right: {{ gap }}px;"><text class="back-btn-text" style="font-size: {{ textSize }}px;">&#x8fd4;&#x56de;</text></div>
      <div class="sync-btn" @click="onSyncClick" style="width: {{ buttonW }}px; height: {{ buttonH }}px;"><text class="sync-btn-text" style="font-size: {{ textSize }}px;">&#x540c;&#x6b65;</text></div>
    </div>
  </div>
</div>
